# The dvorak-ola Worker. See ./README.md for the installation this describes,
# and ../../../deploy/systemd/worker.env.example for what every Worker is
# configured with regardless of its model.
#
# The instance is named after the checkpoint it serves rather than after the
# model, so this file is copied to a name that changes with the checkpoint —
# serving a new one is a new instance beside the old, not an edit to this. See
# "Naming a worker instance" in ../../../docs/deploying-to-a-vm.md.
#
#   instance=dvorak-ola-2.0-2025-03-09
#   sudo install -o root -g musibot -m 0640 \
#       worker-dvorak-ola.env.example "/etc/musibot/worker-$instance.env"


# --- dvorak-ola -------------------------------------------------------------
# Two things about this Model are deployment decisions and both are on this
# line: the checkpoint it serves, and the version it therefore announces. A
# YOLO checkpoint carries no identity of its own, so unlike Zeus — which reads
# its name and version out of its snapshot — the two are stated here and have
# to be kept in step by hand. Getting it wrong merges two different checkpoints
# into one registry entry, and a Pipeline that pinned the version gets whichever
# Worker answered.
#
# The rest of the command line is defaults a Pipeline can override per
# execution through `parameters` — `--confidence`, `--iou`, `--image-size`,
# `--max-detections`. `musibot-dvorak-ola --help` is the full list.
MUSIBOT_MODEL_COMMAND="/opt/musibot/models/dvorak-ola/venv/bin/musibot-dvorak-ola --weights /opt/musibot/models/dvorak-ola/weights/ola-layout-analysis-2.0-2025-03-09.pt --model-version 2.0-2025-03-09"

# MUSIBOT_PAGES_DIR is deliberately absent — the unit derives it from the
# instance name. See ../../../deploy/systemd/worker.env.example.

# Loading torch and the weights takes some seconds, and this Worker is offered
# no work until it is done. Well short of what Zeus needs, and left generous
# because the first start on a cold page cache is the slow one.
MUSIBOT_MODEL_READY_TIMEOUT_SECONDS=120


# --- RabbitMQ ---------------------------------------------------------------
MUSIBOT_RABBIT_HOST=127.0.0.1
MUSIBOT_RABBIT_PORT=5672
MUSIBOT_RABBIT_USER=musibot
MUSIBOT_RABBIT_PASSWORD=CHANGE_ME
MUSIBOT_RABBIT_VHOST=/


# --- MinIO ------------------------------------------------------------------
MUSIBOT_S3_ENDPOINT_URL=http://127.0.0.1:9000
MUSIBOT_S3_ACCESS_KEY=CHANGE_ME
MUSIBOT_S3_SECRET_KEY=CHANGE_ME

# Must match the api service exactly, or this Worker writes layout files where
# nothing looks for them and reports that its input file does not exist.
MUSIBOT_S3_BUCKET=musibot
MUSIBOT_S3_KEY_PREFIX=s3/


# --- logging ----------------------------------------------------------------
MUSIBOT_LOG_LEVEL=INFO
MUSIBOT_LOG_FORMAT=text


# --- ultralytics and torch --------------------------------------------------
# Not Musibot settings. They are here because the Model inherits this
# environment — it is a child of the worker head process — so this file is the
# one place a model's own tuning belongs.
#
# Ultralytics writes a settings file on import and has nowhere to put it under
# a unit with no home directory. It falls back to /tmp with a warning rather
# than failing, which works and is worth not relying on. Point it at something
# the musibot user owns; ultralytics creates an `Ultralytics/` folder inside
# whatever this names. The unit's StateDirectory is per instance, so this is
# too — and it changes with the instance name like everything else here.
YOLO_CONFIG_DIR=/var/lib/musibot/dvorak-ola-2.0-2025-03-09

# Ultralytics checks for updates and reports anonymous usage statistics unless
# told not to. It is a Model on a university machine processing other people's
# scans; it should not be talking to anyone.
YOLO_OFFLINE=true

# Torch sizes its thread pools to the whole machine unless told otherwise, so
# two Workers on one VM each try to use every core and both get slower. Set
# this to roughly (cores / workers) when there is more than one; leave it out
# when this is the only Worker on the VM and it should have the machine.
#
# OMP_NUM_THREADS=4
