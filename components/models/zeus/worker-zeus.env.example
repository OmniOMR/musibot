# The Zeus Worker. See ./README.md for the installation this describes, and
# ../../../deploy/systemd/worker.env.example for what every Worker is
# configured with regardless of its model.
#
# The instance is named after the snapshot it serves rather than after Zeus,
# so this file is copied to a name that changes with the snapshot — swapping
# one is a new instance beside the old, not an edit to this. See "Naming a
# worker instance" in ../../../docs/deploying-to-a-vm.md.
#
#   instance=solo26-zod-bw-auth-ft-2026-07-20
#   sudo install -o root -g musibot -m 0640 \
#       worker-zeus.env.example "/etc/musibot/worker-$instance.env"


# --- Zeus -------------------------------------------------------------------
# Two paths across the IPC boundary: the python 3.10 virtual environment Zeus
# lives in, and the snapshot it serves. Nothing else about the model is
# configured here — its name, its version and what it reads all come out of the
# snapshot, because those are what a Pipeline pins and they must travel with
# the weights.
#
# Deploying a different snapshot is an edit to this one line and a restart. It
# changes the model's announced identity, so it is a deployment decision and
# not a tuning one.
#
# --quiet-tf silences TensorFlow's startup chatter, which is otherwise the bulk
# of this unit's journal. Zeus's own output is kept: it is captured as the
# model's log and is where a failed transcription is explained.
MUSIBOT_MODEL_COMMAND="/opt/musibot/models/zeus/venv/bin/zeus musibot --model-snapshot /opt/musibot/models/zeus/snapshots/zod-bw-auth-ft-2026-07-20.model --quiet-tf"

# MUSIBOT_PAGES_DIR is deliberately absent — the unit derives it from the
# instance name. See ../../../deploy/systemd/worker.env.example.

# Loading TensorFlow and the weights takes tens of seconds, and this Worker is
# offered no work until it is done. The default is already generous; it is here
# because this is the model where it might one day not be.
MUSIBOT_MODEL_READY_TIMEOUT_SECONDS=300


# --- RabbitMQ ---------------------------------------------------------------
MUSIBOT_RABBIT_HOST=127.0.0.1
MUSIBOT_RABBIT_PORT=5672
MUSIBOT_RABBIT_USER=musibot
MUSIBOT_RABBIT_PASSWORD=CHANGE_ME
MUSIBOT_RABBIT_VHOST=/


# --- MinIO ------------------------------------------------------------------
MUSIBOT_S3_ENDPOINT_URL=http://127.0.0.1:9000
MUSIBOT_S3_ACCESS_KEY=CHANGE_ME
MUSIBOT_S3_SECRET_KEY=CHANGE_ME

# Must match the api service exactly, or this Worker writes transcriptions
# where nothing looks for them and reports that its input file does not exist.
MUSIBOT_S3_BUCKET=musibot
MUSIBOT_S3_KEY_PREFIX=s3/


# --- logging ----------------------------------------------------------------
MUSIBOT_LOG_LEVEL=INFO
MUSIBOT_LOG_FORMAT=text


# --- TensorFlow -------------------------------------------------------------
# Not Musibot settings. They are here because the Model inherits this
# environment — it is a child of the worker head process — so this file is the
# one place a model's own tuning belongs.
#
# TensorFlow sizes its thread pools to the whole machine unless told otherwise,
# so two Zeus Workers on one VM each try to use every core and both get slower.
# Set these when there is more than one, to roughly (cores / workers); leave
# them out entirely when this is the only Worker on the VM and it should have
# the machine.
#
# TF_NUM_INTRAOP_THREADS=4
# TF_NUM_INTEROP_THREADS=2
