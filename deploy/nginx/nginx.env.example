# The deployment addresses that fill in musibot.conf.template. Copy to
# /etc/musibot/nginx.env and hand it to render-config.sh.
#
# These are the only things that differ between a VM and the local compose
# stack. Everything else in the template is the same everywhere, which is why
# the stack can exercise that file rather than a copy of it.


# What our nginx listens on. The university proxy forwards here over plain
# HTTP; TLS is terminated at the proxy, not on this VM.
MUSIBOT_LISTEN_PORT=80

# The hostname users type, exactly as a browser sends it in the Host header —
# including a port if it is not the scheme's default. This is the value
# presigned URLs are signed against, and nginx restores it before MinIO
# validates the signature, so a mismatch here surfaces as SignatureDoesNotMatch
# on every download.
MUSIBOT_PUBLIC_HOST=quest.ms.mff.cuni.cz

# The path prefix Musibot is published under. The university proxy strips it
# before forwarding; the template puts it back where it is needed.
MUSIBOT_PUBLIC_PREFIX=/musibot

# Where the Web UI bundle is unpacked. A symlink to the current release, so
# that publishing a new bundle is a swap rather than a copy in place.
MUSIBOT_WEB_ROOT=/var/www/musibot/current

# The services behind nginx, all of them on this VM.
MUSIBOT_API_UPSTREAM=127.0.0.1:8080
MUSIBOT_S3_UPSTREAM=127.0.0.1:9000
MUSIBOT_CONSOLE_UPSTREAM=127.0.0.1:9001
MUSIBOT_RABBITMQ_UPSTREAM=127.0.0.1:15672
