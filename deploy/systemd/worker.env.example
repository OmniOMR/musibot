# Configuration of one Worker on a VM. Copy to /etc/musibot/worker-<instance>.env,
# where <instance> is the systemd instance name: worker-solo26-zod-2026-07-20.env is
# read by musibot-worker@solo26-zod-2026-07-20. Instances are named after the
# snapshot they serve — see "Naming a worker instance" in
# ../../docs/deploying-to-a-vm.md. Filled in for a real model in
# ../../components/models/zeus/worker-zeus.env.example.
#
# `musibot-worker-head --help` is the authoritative list of settings; see
# ../../docs/service-configuration.md for the three sources and their order.
#
# systemd's parser is not a shell: no `export`, no $VARIABLE expansion, and a
# value containing spaces must be "double quoted" — which MUSIBOT_MODEL_COMMAND
# below always does.


# --- the Model this Worker runs ---------------------------------------------
# The command that launches it, split as a shell would split it. Usually an
# absolute path into the model's own virtual environment, which may be a
# different python from the worker head's — nothing crosses that boundary but
# the IPC contract. See ../../docs/deployment.md.
#
# Which model this is, and at which version, is not configured here: the Model
# announces its own name and version over the IPC, because that pair is what a
# Pipeline pins and it must travel with the weights rather than with a
# deployment.
MUSIBOT_MODEL_COMMAND="/opt/musibot/workers/<instance>/venv/bin/python -m <model_module>"

# MUSIBOT_PAGES_DIR is deliberately absent. The unit derives it from the
# instance name (`Environment=MUSIBOT_PAGES_DIR=%S/musibot/%i/pages`) so that it
# cannot drift from the instance this file belongs to. Setting it here would
# silently win — EnvironmentFile= overrides Environment= whichever order they
# are written in — so leave it out unless a worker genuinely needs its mirror
# somewhere other than its own state directory.

# How long to wait for the Model to say `ready`. This is where a model loads
# its weights, and the Worker is simply not offered work during it. Raise it
# for a model that is slow to start rather than letting it be killed halfway.
MUSIBOT_MODEL_READY_TIMEOUT_SECONDS=300


# --- RabbitMQ ---------------------------------------------------------------
# For a Worker on the VM that runs everything. A Worker on a second VM puts
# that VM's hostname here and in the S3 endpoint below, and nothing else about
# this file changes — RabbitMQ and MinIO answer on every interface, and the
# university's internal network is what a Worker reaches them across.
MUSIBOT_RABBIT_HOST=127.0.0.1
MUSIBOT_RABBIT_PORT=5672
MUSIBOT_RABBIT_USER=musibot
MUSIBOT_RABBIT_PASSWORD=CHANGE_ME
MUSIBOT_RABBIT_VHOST=/


# --- MinIO ------------------------------------------------------------------
# Reached directly, as the api service does. A Worker Head never issues
# presigned URLs, so it has no use for s3_public_url.
MUSIBOT_S3_ENDPOINT_URL=http://127.0.0.1:9000
MUSIBOT_S3_ACCESS_KEY=CHANGE_ME
MUSIBOT_S3_SECRET_KEY=CHANGE_ME

# These two must match the api service exactly. Two services rooted differently
# do not fail — they simply stop seeing each other's objects, and an execution
# reports that an input file it was given does not exist.
MUSIBOT_S3_BUCKET=musibot
MUSIBOT_S3_KEY_PREFIX=s3/


# --- logging ----------------------------------------------------------------
MUSIBOT_LOG_LEVEL=INFO
MUSIBOT_LOG_FORMAT=text
