# Configuration of one Orchestrator on a VM. Copy to
# /etc/musibot/orchestrator-<instance>.env, where <instance> is the systemd
# instance name: orchestrator-pmcg.env is read by musibot-orchestrator@pmcg.
#
# The orchestrator's own `--help` is the authoritative list of settings — every
# Orchestrator may add its own to the shared ones below.
# ../../docs/service-configuration.md has the three sources and their order.
#
# systemd's parser is not a shell: no `export`, no $VARIABLE expansion, and a
# value containing spaces must be "double quoted".


# --- which Orchestrator this instance runs ----------------------------------
# Its console script, from its own virtual environment. An Orchestrator is a
# program of its own — it brings its own Pipelines and its own dependencies —
# so the unit runs whatever this names rather than a fixed path.
MUSIBOT_ORCHESTRATOR_COMMAND="/opt/musibot/orchestrators/<instance>/venv/bin/musibot-pmcg-orchestrator"

# How many Pipeline Executions this process runs at once. A Pipeline spends most
# of its life awaiting Models rather than computing, so one process carries
# several; the excess stays in the shared queue where another instance of the
# same Orchestrator can take it.
MUSIBOT_MAX_CONCURRENT_EXECUTIONS=4


# --- settings of this particular Orchestrator -------------------------------
# Everything above is common to every Orchestrator; what follows is not, and
# another Orchestrator's `--help` lists its own. Note what is *not* here: which
# Models a Pipeline runs, and the name and version it is announced under, are
# written down in the Orchestrator's source rather than configured, because a
# Pipeline's name and version are a promise about how it behaves. Changing them
# is a new release of the Orchestrator, not an edit to this file.
#
# pmcg-orchestrator announces every Pipeline it has unless told otherwise. A
# development instance announces only the one being developed — never set this
# on a production instance.
#MUSIBOT_ONLY_PIPELINES='["mzk-page@3-dev"]'


# --- RabbitMQ ---------------------------------------------------------------
# For an Orchestrator on the VM that runs everything. One on a second VM puts
# that VM's hostname here and in the S3 endpoint below, and nothing else about
# this file changes.
MUSIBOT_RABBIT_HOST=127.0.0.1
MUSIBOT_RABBIT_PORT=5672
MUSIBOT_RABBIT_USER=musibot
MUSIBOT_RABBIT_PASSWORD=CHANGE_ME
MUSIBOT_RABBIT_VHOST=/


# --- MinIO ------------------------------------------------------------------
# Reached directly, as the api service and every Worker do. An Orchestrator
# never issues presigned URLs, so it has no use for s3_public_url.
MUSIBOT_S3_ENDPOINT_URL=http://127.0.0.1:9000
MUSIBOT_S3_ACCESS_KEY=CHANGE_ME
MUSIBOT_S3_SECRET_KEY=CHANGE_ME

# These two must match the api service exactly. Two services rooted differently
# do not fail — they simply stop seeing each other's objects, and a Pipeline
# reports that a File it was given does not exist.
MUSIBOT_S3_BUCKET=musibot
MUSIBOT_S3_KEY_PREFIX=s3/


# --- logging ----------------------------------------------------------------
# Everything a Pipeline says reaches a watching User over the log stream, and is
# written here as well — this copy is the one that survives an execution nobody
# was watching.
MUSIBOT_LOG_LEVEL=INFO
MUSIBOT_LOG_FORMAT=text
