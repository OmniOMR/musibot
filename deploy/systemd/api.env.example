# Configuration of the Web API on a VM. Copy to /etc/musibot/api.env and fill
# in the secrets; it is read by musibot-api.service through EnvironmentFile=.
#
# Every key here is an ordinary Musibot setting — the same name the service
# takes as --root-path or reads from a --config-file, only spelled as an
# environment variable. `musibot-api --help` is the authoritative list; see
# ../../docs/service-configuration.md for the three sources and their order.
#
# systemd's parser is not a shell: no `export`, no $VARIABLE expansion, and a
# value containing spaces must be "double quoted". Values are otherwise taken
# literally, trailing whitespace and all.
#
#   sudo install -o root -g musibot -m 0640 api.env.example /etc/musibot/api.env
#
# It holds credentials, so it is not world-readable.


# --- where this process listens ---------------------------------------------
# Loopback only: nginx is the single entry point and reverse-proxies to here.
# This line is not optional. The service *defaults* to every interface, because
# the local development stack reaches it from inside a container, so a VM that
# omitted this would answer the internet directly and bypass nginx entirely.
MUSIBOT_HOST=127.0.0.1
MUSIBOT_PORT=8080

# The public path this service is reached under. nginx strips it before the
# request arrives, so it changes no routing — it exists so the interactive docs
# at /musibot/api/docs can build URLs a browser can follow.
MUSIBOT_ROOT_PATH=/musibot/api


# --- RabbitMQ ---------------------------------------------------------------
MUSIBOT_RABBIT_HOST=127.0.0.1
MUSIBOT_RABBIT_PORT=5672
MUSIBOT_RABBIT_USER=musibot
MUSIBOT_RABBIT_PASSWORD=CHANGE_ME
MUSIBOT_RABBIT_VHOST=/


# --- MinIO ------------------------------------------------------------------
# Where this service reaches MinIO: directly, on the loopback, not through
# nginx.
MUSIBOT_S3_ENDPOINT_URL=http://127.0.0.1:9000
MUSIBOT_S3_ACCESS_KEY=CHANGE_ME
MUSIBOT_S3_SECRET_KEY=CHANGE_ME

# The origin presigned URLs are issued against — the address a User's browser
# redeems them from, which is not the one above. The origin and nothing more:
# the /musibot/s3/ part of the public URL is carried by the bucket and key
# prefix below, not by this.
MUSIBOT_S3_PUBLIC_URL=https://quest.ms.mff.cuni.cz

# The bucket is named after the public prefix's first segment and the rest of
# the prefix is the key prefix, so that the whole public path parses as bucket
# plus key with nothing rewritten. This is not a free choice — see
# ../../docs/deployment.md. Every Worker Head must be given the same two values
# or it will write objects this service cannot see.
MUSIBOT_S3_BUCKET=musibot
MUSIBOT_S3_KEY_PREFIX=s3/


# --- who may call -----------------------------------------------------------
# A JSON object mapping API token to the Library user it identifies. Without
# it the service comes up accepting the built-in development token `secret` and
# says so in its log, which is not a production configuration.
MUSIBOT_API_TOKENS_FILE=/etc/musibot/api-tokens.json


# --- the General public tier ------------------------------------------------
# On by default, because the Web UI cannot do anything without it — so a
# Libraries-only deployment switches it off here, deliberately. What each of
# these bounds, and why the global pair is the one that matters, is in
# ../../docs/public-access.md.
MUSIBOT_PUBLIC_ACCESS_ENABLED=true

# The global cap: how many Pipeline Executions all public sessions together may
# have running. Size it against the Worker fleet — the public can occupy this
# many Workers, so a Library batch run proceeds at (N-K)/N of full speed. Keep
# it above 1, or one public user holds the whole public tier.
MUSIBOT_PUBLIC_MAX_CONCURRENT_EXECUTIONS=2

# 5 GiB. Measured after the fact by the sweep, so set it well under what the
# disk actually has.
MUSIBOT_PUBLIC_STORAGE_QUOTA_BYTES=5368709120

MUSIBOT_PUBLIC_SESSION_TTL_SECONDS=3600
MUSIBOT_PUBLIC_SWEEP_INTERVAL_SECONDS=60
MUSIBOT_PUBLIC_EXECUTION_TIMEOUT_SECONDS=60
MUSIBOT_PUBLIC_MAX_PAGES_PER_SESSION=20
MUSIBOT_PUBLIC_MAX_CONCURRENT_EXECUTIONS_PER_SESSION=1


# --- everyone's ceilings ----------------------------------------------------
# How long any Pipeline Execution may run before it is declared timed out. Long
# enough for the slowest model on this deployment's hardware, and the number to
# revisit first when a Library reports spurious timeouts on a CPU-only VM.
MUSIBOT_PIPELINE_EXECUTION_TIMEOUT_SECONDS=300

# How long a presigned upload or download URL stays valid.
MUSIBOT_FILE_URL_TTL_SECONDS=900


# --- logging ----------------------------------------------------------------
# Text, because the log goes to the journal and is read by a human there.
MUSIBOT_LOG_LEVEL=INFO
MUSIBOT_LOG_FORMAT=text
