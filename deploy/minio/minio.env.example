# MinIO on a VM. Copy to /etc/default/minio, which is the environment file the
# .deb's own minio.service reads. Restart with `systemctl restart minio`.
#
# The compose stack passes the same settings as compose `environment:` keys; the
# ones that matter to Musibot are MINIO_BROWSER_REDIRECT_URL and the bucket
# arrangement (which is not here — it is the api service's and every worker's
# s3_bucket and s3_key_prefix). See ../../docs/deploying-to-a-vm.md.


# The root credentials. Musibot's services do not use these — they get an
# access key of their own, so that rotating a service credential does not mean
# rotating the one that administers the server.
MINIO_ROOT_USER=musibot-admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Where objects live. A single directory, so this is a single-drive deployment
# with no erasure coding: the VM's disk is the durability story, and MinIO adds
# nothing to it. That is the right trade here — every object Musibot stores is
# ephemeral and reproducible by re-uploading the scan.
MINIO_VOLUMES="/var/lib/minio"

# The Console gets a port of its own; the S3 API keeps the default 9000. Both
# answer on every interface, which is what lets a Worker on another VM reach
# object storage directly — it downloads and uploads a page's Files itself
# rather than through the api service.
#
# That is safe here because the VM is not reachable from the internet at all:
# it sits on the university's internal network and the university's proxy is
# the only thing that publishes any of it. See ../../docs/deploying-to-a-vm.md.
MINIO_OPTS="--console-address :9001"

# The public URL of the Console, which is the whole of MinIO's base-path
# support: the Console emits `<base href="…/musibot/minio/">` and references
# every asset relative to it. That is why nginx strips the /minio/ segment
# rather than forwarding it — see ../nginx/musibot.conf.template.
MINIO_BROWSER_REDIRECT_URL=https://quest.ms.mff.cuni.cz/musibot/minio
