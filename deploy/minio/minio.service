# MinIO, as the .deb MinIO used to publish installed it.
#
# MinIO no longer distributes its community server, so this is no longer
# installed by a package: the binary comes out of Musibot's re-hosted image
# (fetch-binaries.sh beside this file) and this unit is the one that package
# shipped, unchanged in what it does. It reads /etc/default/minio — see
# minio.env.example — and runs as `minio-user`.
#
# Copied to /etc/systemd/system/minio.service. The whole installation is in
# ../../docs/deploying-to-a-vm.md, section 3.

[Unit]
Description=MinIO
Documentation=https://github.com/OmniOMR/musibot/blob/main/docs/deploying-to-a-vm.md
Wants=network-online.target
After=network-online.target
AssertFileIsExecutable=/usr/local/bin/minio

[Service]
Type=notify
WorkingDirectory=/usr/local
User=minio-user
Group=minio-user
ProtectProc=invisible

EnvironmentFile=-/etc/default/minio
ExecStartPre=/bin/bash -c "if [ -z \"${MINIO_VOLUMES}\" ]; then echo \"Variable MINIO_VOLUMES not set in /etc/default/minio\"; exit 1; fi"
ExecStart=/usr/local/bin/minio server $MINIO_OPTS $MINIO_VOLUMES

# MinIO handles its own shutdown; let it, however long that takes.
Restart=always
LimitNOFILE=1048576
MemoryAccounting=no
TasksMax=infinity
TimeoutSec=infinity
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
